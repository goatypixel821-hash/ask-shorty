# Copy to .env and fill in values used by Ask Shorty tooling.

# OpenRouter (batch_processor.py --provider openrouter --model <model>)
# Base URL is fixed to https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Default model for OpenRouter (batch_processor, grabber auto-run); override per run with --model
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# If video_grabber.py lives outside this repo, point it at the shorty checkout (for auto batch_processor)
# SHORTY_PROJECT_ROOT=C:\path\to\shorty

# Paths / provider / models: see config.py and ask_shorty.local.toml.example.
# Precedence: these env vars -> ask_shorty.local.toml -> defaults. `python config.py` shows the result.
# Working DB (grabber, batch, V2, library). Default: <repo>/data/transcripts.db
# ASK_SHORTY_DB_PATH=
# Full-library DB (V1 /ask, observatory, courses, check_*.py). Default: the viewer-copy DB under
# ~/Desktop if it exists, else ASK_SHORTY_DB_PATH / the working DB.
# ASK_SHORTY_FULL_DB_PATH=
# SHORTY_PROVIDER=openrouter
# Listen address for the Flask apps. Default 127.0.0.1 (this PC only); 0.0.0.0 = LAN / phone.
# ASK_SHORTY_HOST=0.0.0.0

# Ask Shorty V2 (hierarchical BM25 path). Enables GET /ask_v2 and POST /api/ask_v2
# ASK_SHORTY_V2=true
# Optional: directory for video_bm25_index.pkl / segment_bm25_index.pkl / event_bm25_index.pkl
# (default: <db parent>/v2_indexes)
# ASK_SHORTY_V2_INDEX_DIR=
