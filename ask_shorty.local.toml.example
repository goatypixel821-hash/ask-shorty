# Ask Shorty local config. Copy to ask_shorty.local.toml (gitignored) and edit.
#
# Precedence for every setting: environment variable (shell or .env)
#   -> this file -> built-in default.   Run `python config.py` to see what's in effect.
#
# You do NOT need this file on Shaun's current machine: the built-in defaults already
# resolve to the values below. It exists so the paths can be pinned explicitly (or
# changed on another machine) in one place. Use single-quoted 'literal' strings for
# Windows paths so backslashes need no escaping.

# Folder for the working data (grab_log.txt, clusters.json, courses, chroma_model.txt, ...).
# Default: <repo>/data
data_dir = 'C:\Users\number2\Desktop\shorty\data'

# Working DB: grabber, batch_processor, V2 (/ask_v2), library app, ask job store.
# Env: ASK_SHORTY_DB_PATH. Default: <data_dir>/transcripts.db
db_path = 'C:\Users\number2\Desktop\shorty\data\transcripts.db'

# Full library DB: V1 (/ask), observatory, clusters, courses, check_*.py scripts.
# Env: ASK_SHORTY_FULL_DB_PATH (or ASK_SHORTY_FULL_DB), then ASK_SHORTY_DB_PATH.
# Default: ~/Desktop/youtube-history-viewer-copy/data/transcripts.db if it exists, else db_path
full_db_path = 'C:\Users\number2\Desktop\youtube-history-viewer-copy\data\transcripts.db'

# Chroma store used by V1 / the indexer. Env: ASK_SHORTY_CHROMA_PATH.
# Default: <data_dir>/transcript_chroma_finetuned
chroma_path = 'C:\Users\number2\Desktop\shorty\data\transcript_chroma_finetuned'

# Chroma store next to the full library DB (evaluate_rag.py default; start_full.bat sets
# ASK_SHORTY_CHROMA_PATH to it). Env: ASK_SHORTY_FULL_CHROMA_PATH, then ASK_SHORTY_CHROMA_PATH.
full_chroma_path = 'C:\Users\number2\Desktop\youtube-history-viewer-copy\data\transcript_chroma_new'

# LLM provider for Shorty generation: "openrouter" (default) or "anthropic". Env: SHORTY_PROVIDER.
provider = "openrouter"
# Optional model overrides (defaults shown). Env: SHORTY_MODEL / ANSWER_MODEL / OPENROUTER_MODEL.
# shorty_model = "anthropic/claude-3-haiku"          # anthropic provider default: claude-3-haiku-20240307
# answer_model = "claude-sonnet-4-20250514"
# openrouter_model = "qwen/qwen-2.5-72b-instruct"

# Address the Flask apps (5000 grabber, 5001 ask, 5002 library) listen on. Env: ASK_SHORTY_HOST.
# "127.0.0.1" (default) = this computer only. "0.0.0.0" = reachable from your LAN/phone (no auth!).
host = "127.0.0.1"

# Allow creating a missing DB (normally an error). Prefer `python config.py init-db` instead.
# Env: ASK_SHORTY_CREATE_DB.
create_db = false
